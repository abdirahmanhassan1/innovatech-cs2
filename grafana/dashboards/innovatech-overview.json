    {
      "type": "timeseries",
      "title": "Failed SSH logins per server",
      "description": "",
      "id": 12,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (host) (count_over_time({job=\"auth\"} |~ `Invalid user|Failed password|Failed publickey|Connection closed by authenticating user` [5m]))",
          "legendFormat": "{{host}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
